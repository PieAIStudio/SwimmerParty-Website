    "voices": [
      {
        "slot": "intro",
        "source": "voices/kate-murray/kate-murray__voice__intro__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/SwimmerParty-Website/media-pack/library/staging/kate-murray/voice/frozen/kate-murray__voice__intro__v1.wav",
        "sha256": "b178e302711175e5ca18fb61ceb22e9b5149d8adab212d80d33ce4acec085ba2",
        "bytes": 1119514,
        "version": 1,
        "transcript": "Hiya, I'm Kate Murray, twenty-nine, from Glasgow. The buzz cut makes me look much fiercer than I am. I teach English at a kindergarten in Shanghai. The children call me their bald teacher, which is fair enough. Five minutes into story time, they usually forget to be scared of me."
      },
      {
        "slot": "intro-alt",
        "source": "voices/kate-murray/kate-murray__voice__intro-alt__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/SwimmerParty-Website/media-pack/library/staging/kate-murray/voice/frozen/kate-murray__voice__intro-alt__v1.wav",
        "sha256": "6c60eef959c84d33ed7f8598f6c4c9709cfa6ea5599c3d72288b18f0eeff025e",
        "bytes": 1056928,
        "version": 1,
        "transcript": "你好，我叫Kate Murray，来自格拉斯哥，今年二十九。我在上海的幼儿园教英语。头发剃得很短，看起来有点凶，其实我每天都在讲故事。孩子们叫我光头老师，我觉得这个名字挺好记的。"
      },
      {
        "slot": "chat",
        "source": "voices/kate-murray/kate-murray__voice__chat__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/SwimmerParty-Website/media-pack/library/staging/kate-murray/voice/frozen/kate-murray__voice__chat__v1.wav",
        "sha256": "4e4bf671f780993a9976a10ccb5ee28194efe31450453e765cfef4bdf35dc38f",
        "bytes": 612138,
        "version": 1,
        "transcript": "All right, which animal do you think is hiding behind this page? Have a proper guess. No, it isn't me. I haven't got a tail. Come on, let's turn it over together."
      },
      {
        "slot": "happy",
        "source": "voices/kate-murray/kate-murray__voice__happy__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/SwimmerParty-Website/media-pack/library/staging/kate-murray/voice/frozen/kate-murray__voice__happy__v1.wav",
        "sha256": "3bdb11d49b0a352ba6a272071862f8456827740dde2e2a74a3b2efed0631b424",
        "bytes": 702788,
        "version": 1,
        "transcript": "You remembered the whole song! Oh, that's brilliant. We practised it so many times, and today you just stood up and sang it. I'm really proud of you. Shall we do the funny verse again?"
      },
      {
        "slot": "angry",
        "source": "voices/kate-murray/kate-murray__voice__angry__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/SwimmerParty-Website/media-pack/library/staging/kate-murray/voice/frozen/kate-murray__voice__angry__v1.wav",
        "sha256": "bd70d441ae934e5326bb3a9c05dcf98b1622e1b492ccaa8ef6d1c124d9ce57ec",
        "bytes": 580930,
        "version": 1,
        "transcript": "Stop there. We don't push someone because we want the toy. Put it down for a moment and tell me what happened. We'll listen to each other, one at a time."
      },
      {
        "slot": "sad",
        "source": "voices/kate-murray/kate-murray__voice__sad__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/SwimmerParty-Website/media-pack/library/staging/kate-murray/voice/frozen/kate-murray__voice__sad__v1.wav",
        "sha256": "cfaf82e4de52dbe0acac50b998fac624b23cf41899bdbfc967dfe4fbc0c6b8ee",
        "bytes": 716164,
        "version": 1,
        "transcript": "One of the children left me a wee drawing before moving away. Apparently that's me with all the hair. I laughed when I saw it. Then the classroom got quiet, and I missed them more than I expected."
      }
    ]
