    "voices": [
      {
        "slot": "intro",
        "source": "hu-guifen-voice/hu-guifen__voice__intro__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/MediaFactory/factory-workspace/runs/run-actors-hu-tommy-finish-20261024/hu-guifen/voice/final/audio/intro.wav",
        "sha256": "668334f8085589fc480942586e0ef7bcee96978e6f5a08326553951f92e0ce10",
        "bytes": 1382444,
        "version": 1,
        "transcript": "哎哟，我是胡桂芬，武汉的，今年四十五咯。我这个人啊，就是爱笑，一笑脸上两个酒窝。以前在街口帮我姐守过早点摊，什么人都见过。你要我演个热心肠的大姐、厉害的老板娘，那是手到擒来！"
      },
      {
        "slot": "intro-alt",
        "source": "hu-guifen-voice/hu-guifen__voice__intro-alt__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/MediaFactory/factory-workspace/runs/run-actors-hu-tommy-finish-20261024/hu-guifen/voice/final/audio/intro-alt.wav",
        "sha256": "2195154c35da0d4e5ddaff5815926656ac8e9e5f513249abe115e758755f2e7c",
        "bytes": 1689644,
        "version": 1,
        "transcript": "Hi, everyone. I'm Hu Guifen, forty-five, from Wuhan. I love a good laugh, and people say my dimples show up before I do. I used to help my sister at her breakfast stall, so I've seen every kind of customer. Cast me as the warm big sister or the tough boss lady; I can handle it."
      },
      {
        "slot": "chat",
        "source": "hu-guifen-voice/hu-guifen__voice__chat__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/MediaFactory/factory-workspace/runs/run-actors-hu-tommy-finish-20261024/hu-guifen/voice/final/audio/chat.wav",
        "sha256": "a317d2b7f3051e6a57bc446f95ee68ffa61988cf7f2e86eefae3351235179769",
        "bytes": 952364,
        "version": 1,
        "transcript": "武汉过早可有讲究了，热干面得拌匀，豆皮要趁热吃。你要是只喝杯咖啡就出门，我看着都替你饿得慌。"
      },
      {
        "slot": "happy",
        "source": "hu-guifen-voice/hu-guifen__voice__happy__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/MediaFactory/factory-workspace/runs/run-actors-hu-tommy-finish-20261024/hu-guifen/voice/final/audio/happy.wav",
        "sha256": "34339fdfeba0ecdf2ad3146faa1de1299a45bff271fdaeefed896ad143b300ae",
        "bytes": 721964,
        "version": 1,
        "transcript": "哎呀，真选上啦？我就说嘛，咱们有劲儿的人走到哪儿都不怕！今天我请客，热干面、豆皮，大家敞开吃！"
      },
      {
        "slot": "angry",
        "source": "hu-guifen-voice/hu-guifen__voice__angry__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/MediaFactory/factory-workspace/runs/run-actors-hu-tommy-finish-20261024/hu-guifen/voice/final/audio/angry.wav",
        "sha256": "44f630ab808252a344d4357ba49b082bc615d777c2f9b4a32e557f8f33848694",
        "bytes": 691244,
        "version": 1,
        "transcript": "你说话归说话，别拿小姑娘小姑娘地叫我！我四十五了，做事比你还利索。该说明白的现在说明白，别磨磨蹭蹭的！"
      },
      {
        "slot": "sad",
        "source": "hu-guifen-voice/hu-guifen__voice__sad__v1.wav",
        "nativeSource": "/Users/yuanfei/PieAI/MediaFactory/factory-workspace/runs/run-actors-hu-tommy-finish-20261024/hu-guifen/voice/final/audio/sad.wav",
        "sha256": "6ea35e9dfe84f9b6978dc0ee7b579b997673ddeb2da54f14d7bcc5da2655396a",
        "bytes": 1105964,
        "version": 1,
        "transcript": "我姐那早点摊关门那天，锅还热着呢。她说歇几天就回来，可这一歇，就再也没开起来。我到现在路过那条街，还是会闻见油锅的香味。"
      }
    ]
  }
