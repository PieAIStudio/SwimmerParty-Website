  "roles": [
    {
      "id": "he-jie",
      "name": {
        "zh": "何姐",
        "en": "He Jie"
      },
      "actor": "SP-13",
      "looks": [
        "maid"
      ],
      "facts": {
        "zh": [
          "剧组里的中年女演员，重庆人",
          "在短剧里演怯生生的女佣，穿旧女佣制服",
          "一喊卡就变回张罗大小事的重庆大姐，从制服口袋里掏出纸，指挥导演找制片去买药"
        ]
      }
    },
    {
      "id": "dai-er",
      "name": {
        "zh": "戴尔",
        "en": "Dai Er"
      },
      "actor": "SP-03",
      "looks": [
        "ceo"
      ],
      "facts": {
        "zh": [
          "剧组里的男演员",
          "深眼窝、高鼻梁，一张标准的外国霸总脸，其实是老重庆，说重庆话",
          "在短剧里演霸道总裁（少爷）；剧本写黑西装、头发后梳，网站现用宝蓝西装造型（黑/灰西装版曾被 ChatGPT 拦下）",
          "本集喝了掺颜料的假红酒后拉肚子"
        ]
      }
    }
  ],
  "characters": [
    {
      "id": "director",
      "name": {
        "zh": "导演"
      },
      "cast": "SP-14",
      "facts": {
        "zh": [
          "坐在监视器后面，手里捏着话筒",
          "喊\"大家专业一点！\"努力找回威严",
          "对何姐客气：\"晓得晓得，何姐\"",
          "用手机扫码交罚款；对周总说\"既然我是导演，你就要相信我\""
        ]
      }
    },
    {
      "id": "producer",
      "name": {
        "zh": "制片"
